# All optional. The app works with none of these set.

# Port to listen on (hosts like Render and Railway set this for you)
PORT=3000

# Use invented sample data instead of live feeds (for offline development)
DEMO=0

# Your email, sent in the User-Agent to the weather and address-search services, as their usage policies ask
CONTACT_EMAIL=

# Free NYC Open Data app token: higher rate limits. Get one at https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_APP_TOKEN=

# Bluesky handle + app password (Settings > App Passwords). Needed if anonymous post search is refused.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Base-map tiles. Default: OpenStreetMap standard tiles (no key, light use only).
# Example: TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
TILE_URL=
TILE_ATTRIBUTION=
